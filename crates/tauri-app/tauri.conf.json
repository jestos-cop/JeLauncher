{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JeLauncher",
  "version": "0.1.0",
  "identifier": "com.jestos.jelauncher",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JeLauncher",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jestos",
    "copyright": "Copyright © Jestos. Licensed under GPL-3.0-only.",
    "category": "Game",
    "shortDescription": "Minecraft launcher",
    "longDescription": "JeLauncher manages Minecraft instances, mod loaders, mods and modpacks from Modrinth and CurseForge, and launches the game.",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
