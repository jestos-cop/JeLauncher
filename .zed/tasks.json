[
  {
    "label": "Dev",
    "command": "cargo tauri dev",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build: macOS",
    "command": "cargo tauri build --bundles app,dmg",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Build: Windows",
    "command": "cargo tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
